{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Carl",
  "version": "0.1.0",
  "identifier": "com.carl.pos",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Carl",
        "width": 1366,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://app.carl.africa https://*.supabase.co wss://*.supabase.co; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "capabilities": [
        "default"
      ],
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Carl",
    "category": "Business",
    "shortDescription": "Point of sale, inventory and business management",
    "longDescription": "Carl \u2014 point of sale, inventory and business management for multi-branch retail. Keeps selling when the connection does not."
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": [],
      "dialog": true
    }
  }
}
