# ==============================================================================
# Carl — environment configuration
#
# Copy to `.env.local` for local development. Never commit a filled-in copy.
#
# Two rules govern this file:
#   1. Anything prefixed NEXT_PUBLIC_ is compiled into the browser bundle and is
#      therefore PUBLIC. Never put a secret behind that prefix.
#   2. Everything else is server-only and must never be imported from a client
#      component, a Tauri frontend, or a mobile build.
# ==============================================================================

# ---- Supabase: public (safe to expose to the browser) ------------------------
# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The publishable / anon key. Safe in the client ONLY because RLS is enforced on
# every tenant-owned table. If RLS is ever disabled on a table, this key leaks it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Supabase: secret (server-only, never shipped to a client) ---------------
# Bypasses Row Level Security entirely. Used only by server-side platform
# operations (tenant provisioning, device activation) that cannot run as a user.
SUPABASE_SERVICE_ROLE_KEY=
# Direct PostgreSQL connection string, used by migrations and database tests.
# Use the pooled connection string for serverless runtimes.
SUPABASE_DB_URL=

# ---- Application -------------------------------------------------------------
# Canonical public origin, used for redirects and receipt links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# development | test | production
NODE_ENV=development

# ---- Security ----------------------------------------------------------------
# 32+ byte random secret used to derive device activation and device session
# secrets. Generate with: openssl rand -base64 48
CARL_DEVICE_SECRET_PEPPER=

# ---- Observability (optional in development) ---------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# trace | debug | info | warn | error
CARL_LOG_LEVEL=info

# ---- Database test harness ---------------------------------------------------
# pglite  — in-process WASM PostgreSQL. No Docker required. The default.
# pg      — connect to a real PostgreSQL/Supabase instance via SUPABASE_DB_URL.
CARL_TEST_DB_DRIVER=pglite
