# Carl is a monorepo. Vercel's Root Directory is apps/web, so only the web application is
# built — but the desktop terminal and the Rust build tree are excluded from the upload as
# well, because there is no reason to send them and no Rust toolchain there to use them.
#
# The desktop terminal is built by GitHub Actions on macOS and Windows runners
# (.github/workflows/desktop.yml).
apps/desktop/src-tauri/target
apps/desktop/dist

# Test suites. CI runs these; a production build does not.
tests

# Local build output and caches.
**/.next
**/node_modules
**/.turbo

# Never uploaded, whatever else happens.
.env
.env.*
!.env.example
