{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Carl base configuration",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    // Bundler resolution, and relative imports are written WITHOUT a file extension.
    // Carl's workspace packages are consumed as TypeScript source and never emitted, so
    // the ESM ".js-pointing-at-.ts" convention buys nothing here — and Turbopack does not
    // resolve it inside a transpiled workspace package, which fails the production build
    // with "the module has no exports at all".
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,
    "allowUnreachableCode": false,
    "forceConsistentCasingInFileNames": true,

    // Node's definitions supply the globals present in every runtime Carl targets
    // (crypto, TextEncoder, btoa/atob, console). Packages that also run in a browser add
    // "DOM" to `lib`; they do not remove this.
    "types": ["node"],

    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": false,
    "incremental": true,
    "noEmit": true
  },
  "exclude": ["node_modules", "dist", ".next", "coverage"]
}
